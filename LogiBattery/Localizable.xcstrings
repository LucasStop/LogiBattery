    "widget.empty.title": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum aparelho Logitech encontrado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Logitech device found"
          }
