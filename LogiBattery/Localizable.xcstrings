    "permission.window": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão necessária"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso necesario"
          }
        }
      }
    },
    "permission.title": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir leitura dos aparelhos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow reading your devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir lectura de los dispositivos"
          }
        }
      }
    },
    "permission.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LogiBattery precisa de Monitoramento de Entrada para ler a bateria do mouse e do teclado. Nada sai do seu Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LogiBattery needs Input Monitoring to read your mouse and keyboard battery. Nothing leaves your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LogiBattery necesita Monitorización de Entrada para leer la batería del ratón y del teclado. Nada sale de tu Mac."
          }
        }
      }
    },
    "permission.step1": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Clique em Abrir Privacidade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Click Open Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Haz clic en Abrir Privacidad."
          }
        }
      }
    },
    "permission.step2": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Ative o LogiBattery em Monitoramento de Entrada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Turn on LogiBattery under Input Monitoring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Activa LogiBattery en Monitorización de Entrada."
          }
        }
      }
    },
    "permission.step3": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Volte aqui. A leitura começa sozinha."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Come back here. Reading starts by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Vuelve aquí. La lectura comienza sola."
          }
        }
      }
    },
    "permission.open": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Privacidade"
          }
        },
