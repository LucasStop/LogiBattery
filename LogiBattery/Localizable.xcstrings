      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria do mouse e do teclado Logitech."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery of your Logitech mouse and keyboard."
          }
        }
      }
    },
    "popover.updated": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
