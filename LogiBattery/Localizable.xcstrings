      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charging"
          }
        }
      }
    },
