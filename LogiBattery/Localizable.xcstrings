          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical"
          }
        }
      }
    },
    "widget.title": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baterias"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteries"
          }
        }
      }
    },
    "widget.title.stale": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baterias · desatualizado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteries · outdated"
          }
        }
      }
    },
    "widget.stale": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última leitura"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last reading"
          }
        }
      }
    },
    "widget.empty.title": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum aparelho Logitech encontrado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Logitech device found"
          }
        }
      }
    },
    "widget.empty.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o LogiBattery para ligar a leitura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LogiBattery to start reading."
          }
        }
      }
    },
    "widget.description": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria do mouse e do teclado Logitech."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery of your Logitech mouse and keyboard."
          }
        }
      }
    },
    "popover.updated": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated"
          }
        }
      }
    },
    "popover.reading": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lendo…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading…"
          }
        }
      }
    },
    "popover.empty.title": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum aparelho Logitech encontrado"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Logitech device found"
          }
        }
      }
    },
    "popover.empty.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o mouse ou o teclado, ou conecte o receptor USB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the mouse or keyboard, or plug in the USB receiver."
          }
        }
      }
    },
    "popover.quit": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair do LogiBattery"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit LogiBattery"
          }
        }
      }
    },
    "alert.low.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria baixa. Recarregue em breve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low battery. Charge it soon."
          }
        }
      }
    },
    "alert.critical.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria crítica. Conecte o carregador agora."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical battery. Plug in the charger now."
          }
        }
      }
    },
    "alert.full.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga completa. Pode tirar da tomada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully charged. You can unplug it."
          }
        }
      }
    }
  },
  "version": "1.0"
}
