        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga completa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully charged"
          }
        }
      }
    },
    "level.low": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
