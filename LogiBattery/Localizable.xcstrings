    "widget.empty.body": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o LogiBattery para ligar a leitura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open LogiBattery to start reading."
          }
        }
      }
    },
