    "settings.menuBarIcon.hint": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escondido, o app segue lendo e atualizando o widget. Para ver o ícone de novo, abra o LogiBattery pelo Spotlight ou pelo Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When hidden, the app keeps reading and updating the widget. To bring the icon back, open LogiBattery from Spotlight or the Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al ocultarlo, la app sigue leyendo y actualizando el widget. Para volver a ver el icono, abre LogiBattery desde Spotlight o el Finder."
          }
        }
      }
    },
