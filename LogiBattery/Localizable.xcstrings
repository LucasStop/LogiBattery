          "stringUnit": {
            "state": "translated",
            "value": "Could not change it. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar. Inténtalo de nuevo."
          }
        }
      }
    },
    "settings.menuBarIcon": {
