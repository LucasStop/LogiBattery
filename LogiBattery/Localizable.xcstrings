        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS bloqueou o Monitoramento de Entrada. Sem ela não dá para ler a bateria."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked Input Monitoring. Without it the battery cannot be read."
