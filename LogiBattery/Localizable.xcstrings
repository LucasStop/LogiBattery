      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o mouse ou o teclado, ou conecte o receptor USB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the mouse or keyboard, or plug in the USB receiver."
          }
        }
      }
